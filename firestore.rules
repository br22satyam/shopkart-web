rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function validGuestOrderItem(item) {
      return item is map
        && item.keys().hasAll(['id', 'title', 'price', 'qty'])
        && item.keys().hasOnly(['id', 'title', 'price', 'qty'])
        && item.id is string
        && item.id.size() >= 1
        && item.id.size() <= 128
        && item.title is string
        && item.title.size() >= 1
        && item.title.size() <= 200
        && item.price is int
        && item.price >= 1
        && item.price <= 100000000
        && item.qty is int
        && item.qty >= 1
        && item.qty <= 10;
    }

    function validGuestOrderItems(items) {
      return items is list
        && items.size() >= 1
        && items.size() <= 10
        && (items.size() <= 0 || validGuestOrderItem(items[0]))
        && (items.size() <= 1 || validGuestOrderItem(items[1]))
        && (items.size() <= 2 || validGuestOrderItem(items[2]))
        && (items.size() <= 3 || validGuestOrderItem(items[3]))
        && (items.size() <= 4 || validGuestOrderItem(items[4]))
        && (items.size() <= 5 || validGuestOrderItem(items[5]))
        && (items.size() <= 6 || validGuestOrderItem(items[6]))
        && (items.size() <= 7 || validGuestOrderItem(items[7]))
        && (items.size() <= 8 || validGuestOrderItem(items[8]))
        && (items.size() <= 9 || validGuestOrderItem(items[9]));
    }

    function validGuestOrder(trackingId) {
      let data = request.resource.data;
      return data.keys().hasAll([
          'customerName', 'email', 'phone', 'address', 'city', 'state', 'pincode',
          'userId', 'guestOrder', 'orderId', 'trackingCode', 'items', 'subtotal',
          'deliveryFee', 'totalAmount', 'currency', 'paymentMethod', 'paymentStatus',
          'status', 'createdAt'
        ])
        && data.keys().hasOnly([
          'customerName', 'email', 'phone', 'address', 'city', 'state', 'pincode',
          'userId', 'guestOrder', 'orderId', 'trackingCode', 'items', 'subtotal',
          'deliveryFee', 'totalAmount', 'currency', 'paymentMethod', 'paymentStatus',
          'status', 'createdAt'
        ])
        && data.customerName is string
        && data.customerName.size() >= 2
        && data.customerName.size() <= 100
        && data.email is string
        && data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$')
        && data.phone is string
        && data.phone.matches('^[+()0-9 -]{7,20}$')
        && data.address is string
        && data.address.size() >= 8
        && data.address.size() <= 500
        && data.city is string
        && data.city.size() >= 2
        && data.city.size() <= 100
        && data.state is string
        && data.state.size() >= 2
        && data.state.size() <= 100
        && data.pincode is string
        && data.pincode.matches('^[0-9]{6}$')
        && data.userId == null
        && data.guestOrder == true
        && data.trackingCode == trackingId
        && trackingId.matches('^SK-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$')
        && data.orderId.matches('^ORD_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$')
        && validGuestOrderItems(data.items)
        && data.subtotal is int
        && data.subtotal >= 1
        && data.subtotal <= 100000000
        && data.deliveryFee is int
        && data.deliveryFee == (data.subtotal < 999 ? 99 : 0)
        && data.totalAmount is int
        && data.totalAmount == data.subtotal + data.deliveryFee
        && data.currency == 'inr'
        && data.paymentMethod == 'Demo checkout'
        && data.paymentStatus == 'No payment collected'
        && data.status == 'Pending'
        && data.createdAt == request.time;
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 2
        && request.resource.data.title.size() <= 200
        && request.resource.data.price is int
        && request.resource.data.price > 0
        && request.resource.data.category is string
        && request.resource.data.category.size() >= 1
        && request.resource.data.category.size() <= 100
        && request.resource.data.image is string
        && (request.resource.data.image.matches('https://.*')
          || request.resource.data.image == 'images/Apple-MacBook-Air-M2.jpg'
          || request.resource.data.image == 'images/watch.jpg.jpg')
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 5
        && request.resource.data.description.size() <= 2000
        && request.resource.data.stock is int
        && request.resource.data.stock >= 0
        && request.resource.data.stock <= 100000
        && request.resource.data.available is bool
        && (!('deleted' in request.resource.data)
          || request.resource.data.deleted is bool);
      allow delete: if isAdmin();
    }

    match /orders/{trackingId} {
      allow get: if isAdmin()
        || (resource.data.guestOrder == true && resource.data.trackingCode == trackingId)
        || (request.auth != null && resource.data.userId == request.auth.uid);
      allow list: if isAdmin()
        || (request.auth != null && resource.data.userId == request.auth.uid);
      allow create: if validGuestOrder(trackingId);
      allow update, delete: if false;
    }
  }
}
